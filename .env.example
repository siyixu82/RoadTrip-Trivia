# Supabase — copy to .env.local and fill in from your Supabase project settings (API).
# Both are safe to expose to the browser (the anon key is gated by Row-Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only secret (NEVER prefix with NEXT_PUBLIC). Bypasses RLS — used only by
# the catalog loader script (scripts/load-quizzes.mjs) to upsert quizzes.
# Supabase Dashboard → Settings → API → service_role key.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
